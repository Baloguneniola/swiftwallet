generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String           @id @default(cuid())
  firstName            String
  lastName             String
  email                String           @unique
  passwordHash         String
  emailVerified        Boolean          @default(false)
  verificationCode     String?
  verificationExpires  DateTime?
  phoneNumber          String?
  dateOfBirth          DateTime?
  residentialAddress   String?
  country              String?
  stateProvince        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  account              Account?
  transactions         Transaction[]
  sentTransfers        Transfer[]       @relation("SenderTransfers")
  receivedTransfers    Transfer[]       @relation("RecipientTransfers")
  billPayments         BillPayment[]
  securitySettings     SecuritySettings?
  cards                Card[]
}

model Account {
  id            String   @id @default(cuid())
  userId        String   @unique
  accountNumber String   @unique
  balance       Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Decimal
  description String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transfer {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  amount      Decimal
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  sender      User     @relation("SenderTransfers", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("RecipientTransfers", fields: [recipientId], references: [id], onDelete: Cascade)
}

model BillPayment {
  id        String   @id @default(cuid())
  userId    String
  service   String
  amount    Decimal
  reference String
  status    String   @default("completed")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecuritySettings {
  id                       String  @id @default(cuid())
  userId                   String  @unique
  pinHash                  String?
  twoFactorEnabled         Boolean @default(false)
  loginNotifications       Boolean @default(true)
  transactionNotifications Boolean @default(true)
  securityAlerts           Boolean @default(true)

  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id         String   @id @default(cuid())
  userId     String
  cardNumber String
  expiryDate String
  frozen     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}