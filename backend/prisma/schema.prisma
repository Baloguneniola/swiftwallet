generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(cuid())
  firstName            String
  lastName             String
  email                String            @unique
  passwordHash         String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  emailVerified        Boolean           @default(false)
  verificationCode     String?
  verificationExpires  DateTime?
  passwordResetCode    String?
  passwordResetExpires DateTime?
  country              String?
  dateOfBirth          DateTime?
  phoneNumber          String?
  residentialAddress   String?
  stateProvince        String?
  identityDocument     String?
  identityNumber       String?
  identityType         String?
  nationality          String?
  account              Account?
  billPayments         BillPayment[]
  cards                Card[]
  securitySettings     SecuritySettings?
  transactions         Transaction[]
  receivedTransfers    Transfer[]        @relation("RecipientTransfers")
  sentTransfers        Transfer[]        @relation("SenderTransfers")
}

model Account {
  id            String   @id @default(cuid())
  userId        String   @unique
  accountNumber String   @unique
  balance       Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Decimal
  description String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transfer {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  amount      Decimal
  status      String   @default("completed")
  createdAt   DateTime @default(now())
  recipient   User     @relation("RecipientTransfers", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("SenderTransfers", fields: [senderId], references: [id], onDelete: Cascade)
}

model BillPayment {
  id        String   @id @default(cuid())
  userId    String
  service   String
  amount    Decimal
  reference String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecuritySettings {
  id                       String  @id @default(cuid())
  userId                   String  @unique
  pinHash                  String?
  twoFactorEnabled         Boolean @default(false)
  loginNotifications       Boolean @default(true)
  transactionNotifications Boolean @default(true)
  securityAlerts           Boolean @default(true)
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id         String   @id @default(cuid())
  userId     String
  cardNumber String
  expiryDate String
  frozen     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
